@model List<Ticket>

@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tickets</h2>
    <a asp-action="Create" class="btn btn-primary">Create New Ticket</a>
</div>

<!-- Search and Filter -->
<form method="get" asp-action="Index" class="row mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by title or description..." />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            <option value="Open" selected="@(ViewBag.Status == "Open")">Open</option>
            <option value="InProgress" selected="@(ViewBag.Status == "InProgress")">In Progress</option>
            <option value="Closed" selected="@(ViewBag.Status == "Closed")">Closed</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Created By</th>
            <th>Status</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center">No tickets found.</td>
            </tr>
        }
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Title</td>
                <td>@ticket.CategoryName</td>
                <td>@ticket.CreatedByName</td>
                <td>
                    @if (ticket.Status == "Open")
                    {
                        <span class="badge bg-primary">Open</span>
                    }
                    else if (ticket.Status == "InProgress")
                    {
                        <span class="badge bg-warning text-dark">In Progress</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Closed</span>
                    }
                </td>
                <td>@ticket.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-info">Details</a>
                    <form asp-action="Delete" asp-route-id="@ticket.Id" method="post" style="display:inline;"
                          onsubmit="return confirm('Are you sure you want to delete this ticket?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@ViewBag.Search"
                       asp-route-status="@ViewBag.Status">@i</a>
                </li>
            }
        </ul>
    </nav>
}