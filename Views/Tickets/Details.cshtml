@model Ticket

@{
    ViewData["Title"] = "Ticket Details";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">@Model.Title</h4>
        <div>
            @if (Model.Status == "Open")
            {
                <span class="badge bg-primary">Open</span>
            }
            else if (Model.Status == "InProgress")
            {
                <span class="badge bg-warning text-dark">In Progress</span>
            }
            else
            {
                <span class="badge bg-secondary">Closed</span>
            }
        </div>
    </div>
    <div class="card-body">
        <p><strong>Description:</strong></p>
        <p>@Model.Description</p>
        <hr />
        <p><strong>Category:</strong> @Model.CategoryName</p>
        <p><strong>Created By:</strong> @Model.CreatedByName</p>
        <p><strong>Created Date:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</p>

        <hr />
        <p><strong>Change Status:</strong></p>
        <div class="d-flex gap-2">
            @if (Model.Status != "Open")
            {
                <form asp-action="UpdateStatus" method="post" style="display:inline;">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="status" value="Open" />
                    <button type="submit" class="btn btn-sm btn-primary">Set Open</button>
                </form>
            }
            @if (Model.Status != "InProgress")
            {
                <form asp-action="UpdateStatus" method="post" style="display:inline;">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="status" value="InProgress" />
                    <button type="submit" class="btn btn-sm btn-warning">Set In Progress</button>
                </form>
            }
            @if (Model.Status != "Closed")
            {
                <form asp-action="UpdateStatus" method="post" style="display:inline;">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="status" value="Closed" />
                    <button type="submit" class="btn btn-sm btn-secondary">Set Closed</button>
                </form>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Comments (@Model.Comments.Count)</h5>
    </div>
    <div class="card-body">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (Model.Comments.Count == 0)
        {
            <p class="text-muted">No comments yet.</p>
        }

        @foreach (var comment in Model.Comments)
        {
            <div class="border rounded p-3 mb-2">
                <div class="d-flex justify-content-between">
                    <strong>@comment.CreatedByName</strong>
                    <small class="text-muted">@comment.CreatedDate.ToString("yyyy-MM-dd HH:mm")</small>
                </div>
                <p class="mb-0 mt-1">@comment.CommentText</p>
            </div>
        }

        @if (Model.Status != "Closed")
        {
            <hr />
            <form asp-action="AddComment" method="post">
                <input type="hidden" name="ticketId" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label">Add a Comment</label>
                    <textarea name="commentText" class="form-control" rows="3" placeholder="Write your comment here..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Add Comment</button>
            </form>
        }
        else
        {
            <div class="alert alert-info mt-3">This ticket is closed. You cannot add new comments.</div>
        }
    </div>
</div>